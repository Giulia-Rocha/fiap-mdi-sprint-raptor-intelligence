{
  "cli": {
    "version": ">= 16.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_USE_MOCKS": "false",
        "EXPO_PUBLIC_API_URL": "https://raptor-intelligence-api-production.up.railway.app",
        "EXPO_PUBLIC_DEV_EMAIL": "admin@ford.com.br",
        "EXPO_PUBLIC_DEV_PASSWORD": "password"
      }
    },
    "production": {
      "autoIncrement": true
    }
  }
}